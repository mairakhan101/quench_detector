#!/bin/bash
#PBS -A fanc_ldrd
#PBS -q prod
#PBS -l select=30:system=polaris
#PBS -l walltime=03:00:00
#PBS -l filesystems=home:eagle
#PBS -l place=scatter
#PBS -N noise_bench_prod
#PBS -j oe

# Production noise+diffusion benchmark: uniform sampling.
# 30 nodes = 5 conductors × 6 noise levels.
# Each node trains 4 architectures (gru, transformer, ssm, diffusion) at
# one conductor/noise combo. ~15 min per arch × 4 = ~60 min per node.
#
# Submit:  qsub scripts/polaris/run_noise_bench_prod.pbs
#
# Results: /eagle/fanc_ldrd/magnets_fem/noise_bench_uniform/

set -euo pipefail

export NOISE_BENCH_OUT=/eagle/fanc_ldrd/magnets_fem/noise_bench_uniform
export NOISE_BENCH_MODE=uniform

REPO=$HOME/fanc/magnets_rl/quench_detector
pbsdsh "$REPO/scripts/polaris/noise_bench_worker.sh"
